---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Solace" description="This page doesn't exist." path="/404">
	<section class="mx-auto max-w-3xl px-6 py-32 text-center">
		<h1 class="text-3xl font-semibold tracking-tight text-white">Page not found</h1>
		<p class="mt-4 text-neutral-400">The page you're looking for doesn't exist.</p>
		<a href="/" class="mt-8 inline-block rounded-full bg-emerald-500 px-5 py-3 text-sm font-medium text-emerald-950 transition hover:bg-emerald-400">
			Back to home
		</a>
	</section>
</BaseLayout>
