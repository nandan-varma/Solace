---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10">
	<div class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-8 text-sm text-neutral-400 sm:flex-row sm:items-center sm:justify-between">
		<p>&copy; {year} Solace. Free and open-source.</p>
		<nav class="flex flex-wrap gap-x-6 gap-y-2">
			<a href="/support" class="transition hover:text-white">Support</a>
			<a href="/privacy" class="transition hover:text-white">Privacy</a>
			<a href="/terms" class="transition hover:text-white">Terms</a>
			<a href="https://github.com/nandan-varma/Solace" class="transition hover:text-white">GitHub</a>
			<a href="mailto:contact@nandan.fyi" class="transition hover:text-white">Contact</a>
		</nav>
	</div>
	<div class="mx-auto max-w-5xl px-6 pb-8 text-xs text-neutral-400">
		<p>
			Product data from <a href="https://world.openfoodfacts.org" class="underline underline-offset-4 hover:text-neutral-300">Open Food Facts</a>,
			available under the <a href="https://opendatacommons.org/licenses/odbl/1-0/" class="underline underline-offset-4 hover:text-neutral-300">Open Database License (ODbL)</a>.
		</p>
	</div>
</footer>
